# Backend base URL. Leave unset and the browser uses the host it loaded this page from,
# on NEXT_PUBLIC_API_PORT (default 8400): one build works locally and from a remote machine.
# Set it only when the backend lives on a different host than the frontend.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PORT=8400

# Sent as X-API-Token on mutating calls (kill, re-arm, manual close) when the backend has
# AIT_API_TOKEN set. NEXT_PUBLIC_ values are embedded in the browser bundle, so this only
# stops callers who never loaded the page; keep the ports on a trusted network or SSH tunnel.
NEXT_PUBLIC_API_TOKEN=
