# Copy to .env. Never commit .env.
AIT_MODE=paper                     # paper | live   (Robinhood's MCP has NO paper mode: live = real money)
AIT_LIVE_CONFIRM=                  # live only: must be exactly I-ACCEPT-REAL-MONEY-RISK
AIT_DATA_SOURCE=auto               # auto | robinhood | yfinance | synthetic
AIT_IGNORE_CLOCK=false             # true only with synthetic data (demo outside market hours)
AIT_OPENROUTER_API_KEY=            # hosted models. With neither this nor a local URL, agents are a labelled offline heuristic (paper only)
AIT_LOCAL_LLM_URL=                 # OpenAI-compatible local server, e.g. http://127.0.0.1:11434/v1 (Ollama); used by `local/...` models
AIT_LOCAL_LLM_API_KEY=             # only if your local server wants one
AIT_LOCAL_LLM_TIMEOUT=120          # seconds; local models are slower (thinking calls get at least 360)
AIT_LOCAL_LLM_THINKING=none        # default thinking for local reasoning models: none|low|medium|high (per agent: config.yaml agents.thinking)
AIT_MODEL=                         # optional: every agent uses this one model (./scripts/trader start --llm sets it)
AIT_API_TOKEN=                     # optional: required on kill/rearm/close endpoints when set
AIT_PORT=8400
AIT_HOST=127.0.0.1                 # 0.0.0.0 to reach the API from other machines (the ./scripts/trader script sets this)
AIT_CORS_ORIGINS=                  # extra browser origins: exact (http://192.168.1.20:3400), *:3400 (any host on that port), or *
